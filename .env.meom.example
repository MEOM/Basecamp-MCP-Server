# MEOM-hardened Basecamp MCP — copy to `.env` and fill in. NEVER commit your real .env.
#
# Setup:
#   1) Fill the three BASECAMP_* values below (from your OAuth app + Basecamp account).
#   2) Generate the two local secrets (run twice, paste one into each):
#        python3 -c "import secrets; print(secrets.token_hex(24))"
#   3) Set BASECAMP_MCP_TOKEN_FILE to the ABSOLUTE path of this repo's oauth_tokens.json.
#   4) Use a LIMITED Basecamp user — added only to the projects the agent may touch.

# --- OAuth (FastMCP path) — fill these three ---
BASECAMP_CLIENT_ID=
BASECAMP_CLIENT_SECRET=
BASECAMP_ACCOUNT_ID=

# --- Loopback redirect — MUST exactly match the Basecamp app registration ---
BASECAMP_REDIRECT_URI=http://127.0.0.1:8000/auth/callback
USER_AGENT=MEOM Basecamp MCP (your-email@meom.fi)

# --- Local secrets (generate your own; replaces the repo's public default key) ---
FLASK_SECRET_KEY=
MCP_API_KEY=

# --- OAuth token file (absolute path; written by oauth_app.py on login) ---
BASECAMP_MCP_TOKEN_FILE=/ABSOLUTE/PATH/TO/Basecamp-MCP-Server/oauth_tokens.json

# --- Tokens (written automatically after login; leave empty) ---
BASECAMP_ACCESS_TOKEN=
BASECAMP_REFRESH_TOKEN=

# --- Optional basic-auth path (NOT used by OAuth/FastMCP) ---
# BASECAMP_USERNAME=
# BASECAMP_PASSWORD=
